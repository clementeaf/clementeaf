{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsc && serverless offline",
    "dev:local": "tsc && AWS_ENDPOINT_URL=http://localhost:4566 serverless offline",
    "dev:docker": "docker-compose up",
    "localstack:up": "docker-compose up localstack -d",
    "localstack:down": "docker-compose stop localstack",
    "docker:build": "docker-compose build",
    "deploy": "tsc && serverless deploy",
    "deploy:aws": "tsc && serverless deploy --stage prod",
    "build": "tsc",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "seed:warehouses": "tsc && node dist/migrations/seed-warehouses.js"
  },
  "dependencies": {
    "@aws-sdk/client-apigatewaymanagementapi": "^3.927.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.927.0",
    "@aws-sdk/client-dynamodb": "^3.927.0",
    "@aws-sdk/client-eventbridge": "^3.928.0",
    "@aws-sdk/client-s3": "^3.926.0",
    "@aws-sdk/client-ses": "^3.928.0",
    "@aws-sdk/client-textract": "^3.948.0",
    "@aws-sdk/lib-dynamodb": "^3.927.0",
    "@aws-sdk/s3-request-presigner": "^3.928.0",
    "ansis": "^4.2.0",
    "app-root-path": "^3.1.0",
    "axios": "^1.13.2",
    "bcryptjs": "^2.4.3",
    "dotenv": "^17.2.3",
    "jsonwebtoken": "^9.0.2",
    "jwk-to-pem": "^2.0.7",
    "node-fetch": "^2.7.0",
    "pg": "^8.11.3",
    "reflect-metadata": "^0.1.13",
    "serverless": "^3.38.0",
    "sql-highlight": "^6.1.0",
    "typeorm": "^0.3.17",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.130",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/jwk-to-pem": "^2.0.3",
    "@types/node": "^20.11.0",
    "@types/node-fetch": "^2.6.13",
    "@types/pg": "^8.10.9",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "serverless-offline": "^13.0.0",
    "serverless-plugin-split-stacks": "^1.14.0",
    "serverless-plugin-typescript": "^2.1.0",
    "typescript": "^5.3.3",
    "ws": "^8.18.3"
  }
}
